{
  "schemaVersion": 2,
  "ollama": {
    "url": "http://localhost:11434",
    "healthTimeoutSec": 15,
    "maxAttempts": 2,
    "retryBackoffSec": 5,
    "warmup": false
  },
  "defaults": {
    "profile": "fast",
    "options": {
      "temperature": 0.2
    },
    "safetyMarginRatio": 0.10,
    "charsPerToken": 3.5,
    "stripThinking": true
  },
  "profiles": {
    "fast": {
      "model": "qwen3.5:9b",
      "contextWindow": 16384,
      "timeoutSec": 900,
      "reservedOutputTokens": 4096,
      "think": "default"
    },
    "deep": {
      "model": "qwen3.6:35b",
      "contextWindow": 16384,
      "timeoutSec": 900,
      "reservedOutputTokens": 8192,
      "think": "default"
    },
    "review": {
      "model": "qwen3.6:35b",
      "contextWindow": 16384,
      "timeoutSec": 900,
      "reservedOutputTokens": 8192,
      "think": "default",
      "options": {
        "temperature": 0.1,
        "seed": 42
      }
    }
  },
  "agents": {
    "spec": { "profile": "fast" },
    "spec-reviewer": { "profile": "review" },
    "spec-reviser": { "profile": "deep" },
    "developer": { "profile": "deep" }
  }
}
